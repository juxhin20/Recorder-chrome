{
  "manifest_version": 3,
  "name": "Recorder Chrome AppAlbania",
  "short_name": "Recorder",
  "version": "1.1.1",
  "description": "Record a tab in Full HD and take screenshots (area, visible or full page) with pen, arrow, box and text. Saved with date and site name.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Recorder Chrome AppAlbania",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "options_page": "src/options.html",
  "permissions": ["scripting", "tabCapture", "offscreen", "storage", "unlimitedStorage", "downloads", "downloads.open", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Start / stop recording the current tab"
    },
    "take-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Screenshot: select an area"
    }
  }
}
